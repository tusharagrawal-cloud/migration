<?xml version="1.0" encoding="utf-8"?>
<!-- Test-only fake values — never real credentials. Needed only so CompositionRoot's static fields construct without throwing; SqlConnectionFactory never actually connects unless a test calls OpenConnectionAsync. -->
<configuration>
  <connectionStrings>
    <add name="Default" connectionString="Server=test-host-not-real;Database=TestOnly;User Id=test;Password=test;TrustServerCertificate=True;" />
  </connectionStrings>
  <appSettings>
    <add key="JwtSigningSecret" value="test-only-signing-secret-never-used-in-production-0123456789" />
    <add key="JwtIssuer" value="one77-api-tests" />
    <add key="JwtAudience" value="one77-admin-tests" />
    <add key="JwtExpiryMinutes" value="720" />
    <add key="CorsAllowedOrigins" value="" />
    <add key="InitialAdminEmail" value="" />
    <add key="InitialAdminPassword" value="" />
  </appSettings>
</configuration>
