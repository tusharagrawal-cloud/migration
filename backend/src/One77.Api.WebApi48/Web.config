<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  TEMPLATE CONFIGURATION — PLACEHOLDERS ONLY. No real secret, password, or
  production connection string belongs in this file. Tushar supplies real
  values for each CHANGE_ME below at deployment time (or via IIS
  environment-specific config transforms / IIS Manager's Configuration
  Editor) — see migration/docs/PRODUCTION_HOST_V1.md for exactly what is
  required and which values are secrets.
  ============================================================================
-->
<configuration>
  <connectionStrings>
    <!-- Secret. SQL Server 2019 connection string. -->
    <!-- providerName intentionally omitted: SqlConnectionFactory (One77.Core) uses Microsoft.Data.SqlClient directly and does not read it. -->
    <add name="Default" connectionString="Server=CHANGE_ME;Database=One77;User Id=CHANGE_ME;Password=CHANGE_ME;TrustServerCertificate=True;" />
  </connectionStrings>

  <appSettings>
    <!-- Secret. A long, random string — never reuse a development value in production. -->
    <add key="JwtSigningSecret" value="CHANGE_ME_GENERATE_A_LONG_RANDOM_PRODUCTION_SECRET" />
    <add key="JwtIssuer" value="one77-api" />
    <add key="JwtAudience" value="one77-admin" />
    <!-- Minutes. 720 = 12 hours, matching the old application's session length. -->
    <add key="JwtExpiryMinutes" value="720" />

    <!-- Comma-separated list of allowed Angular origins, e.g. https://admin.one77sports.example -->
    <add key="CorsAllowedOrigins" value="" />

    <!--
      Secrets, first deployment only. Leave both blank for every deployment
      after the first admin exists — EnsureSeedAdminAsync is a no-op once
      any AdminUsers row exists, but Tushar should still remove these two
      values from the live config after the first successful login as
      routine hygiene (see PRODUCTION_HOST_V1.md).
    -->
    <add key="InitialAdminEmail" value="" />
    <add key="InitialAdminPassword" value="" />
    <add key="InitialAdminName" value="Admin" />

    <!--
      Not secret. Physical folder the homepage hero photograph is saved to.
      Leave blank to default to "<site physical root>/media" — a sibling of
      bin/ and the Angular build output that survives a normal redeploy of
      either. Set to an absolute path only if media should live somewhere
      else (e.g. a separate drive/volume). See PRODUCTION_CONFIGURATION.md.
    -->
    <add key="HomepageMediaPhysicalRoot" value="" />
    <!-- Not secret. Maximum accepted hero-image upload size, in bytes. Default 8 MB. Keep httpRuntime/maxRequestLength and requestFiltering/maxAllowedContentLength below, in sync with this. -->
    <add key="HomepageMediaMaxBytes" value="8388608" />
  </appSettings>

  <system.web>
    <compilation targetFramework="4.8" debug="false" />
    <!-- maxRequestLength is in KB; 10240 KB = 10 MB, comfortably above the 8 MB HomepageMediaMaxBytes app-level check above. -->
    <httpRuntime targetFramework="4.8" maxRequestLength="10240" />
  </system.web>

  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <!-- maxAllowedContentLength is in bytes; matches httpRuntime/maxRequestLength above (IIS enforces this ahead of ASP.NET). -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="10485760" />
      </requestFiltering>
    </security>
    <handlers>
      <remove name="ExtensionlessUrlHandler-Integrated-4.0" />
      <remove name="OPTIONSVerbHandler" />
      <remove name="TRACEVerbHandler" />
      <add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="*" type="System.Web.Handlers.TransferRequestHandler" preCondition="integratedMode,runtimeVersionv4.0" />
    </handlers>

    <!--
      SPA fallback for the Angular Admin/storefront — REQUIRES THE IIS URL
      REWRITE MODULE (a free, separate IIS extension; not installed by
      default — see migration/docs/TUSHAR_DEPLOYMENT_HANDOVER.md).

      This file is deployed as the ONE IIS site's Web.config, with the
      Angular production build's `browser/` output copied into the SAME
      physical folder as this API's own publish output (bin/, this
      Web.config). One site, one Application, one App Pool — see
      "IIS Hosting Structure" in TUSHAR_DEPLOYMENT_HANDOVER.md for why:
      every controller's [RoutePrefix] already bakes "api" into its own
      route (e.g. "api/learn/categories"), matching One77.Api.DevHost's
      contract exactly, so nesting this app under its own "/api" IIS
      virtual directory would double the prefix to "/api/api/...". Hosting
      both from the same physical root avoids that entirely — no
      controller route changes required.

      Rule order matters (stopProcessing on each): requests under /api and
      /health are left alone for ASP.NET Web API to handle; everything
      else that isn't a real file on disk (Angular deep links like
      /airguns, /admin/match, a browser refresh, a pasted URL) is rewritten
      to /index.html so Angular's own router takes over client-side. A
      request for a file that genuinely exists (main.js, styles.css,
      assets/...) is left alone and served by IIS's static file handler.
    -->
    <rewrite>
      <rules>
        <rule name="Preserve API requests" stopProcessing="true">
          <match url="^api/" />
          <action type="None" />
        </rule>
        <rule name="Preserve health checks" stopProcessing="true">
          <match url="^health(/.*)?$" />
          <action type="None" />
        </rule>
        <rule name="Angular SPA fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>

  <runtime>
    <!--
      Extracted from the real build's computed output (obj/.../One77.Api.WebApi48.dll.config,
      generated by AutoGenerateBindingRedirects — see the .csproj) and merged
      here by hand, since IIS reads Web.config's own <runtime> section, not
      that sidecar file. Re-extract and re-merge whenever a package reference
      version changes; a stale redirect here is the classic .NET Framework
      "could not load file or assembly" startup failure.
    -->
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Bcl.AsyncInterfaces" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-10.0.0.8" newVersion="10.0.0.8" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Extensions.Logging.Abstractions" publicKeyToken="adb9793829ddae60" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-8.0.0.2" newVersion="8.0.0.2" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Buffers" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.5.0" newVersion="4.0.5.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Diagnostics.DiagnosticSource" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-10.0.0.3" newVersion="10.0.0.3" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Memory" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.5.0" newVersion="4.0.5.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Text.Encodings.Web" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-10.0.0.3" newVersion="10.0.0.3" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Text.Json" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-10.0.0.3" newVersion="10.0.0.3" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Threading.Tasks.Extensions" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.2.4.0" newVersion="4.2.4.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
