<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <!-- Admin auth (Milestone 10) — both packages ship netstandard2.0/net462+
         assets, so they do not compromise net48/net5 portability. -->
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.16.0" />
    <!-- Order notifications (WhatsApp/SMS) — netstandard2.0 has no built-in
         System.Text.Json; this package ships a netstandard2.0-compatible
         build so senders can build/parse JSON without pulling in a second
         JSON library alongside what the ASP.NET Core hosts already use. -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

</Project>
